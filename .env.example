# Base URL of the backendnew API server (no trailing slash).
# Required — without this, all API calls (waitlist, auth, data management,
# etc.) silently hit the frontend's own origin instead of the backend and
# fail with a 404.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Stellar / Soroban (client-side contract calls signed via Freighter) ---
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Deployed data-storage contract ID (see soroban-contract/README.md "Deployments").
NEXT_PUBLIC_CONTRACT_ID=CDZ27P7XNMEBOGOK2DUXNDBIFG5KNLIPIJYFJCIVVM6LYLM4D55AIUOI
